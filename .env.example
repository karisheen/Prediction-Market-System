# Keep the real webhook URL only in .env. It is not needed for local evaluations.
PMS_DISCORD_WEBHOOK_URL=

PMS_DATABASE_PATH=data/prediction_markets.db
PMS_PAPER_BANKROLL=10000
PMS_MIN_CONSERVATIVE_EDGE=0.03
PMS_UNCERTAINTY_MARGIN=0.05
PMS_STRUCTURAL_WEIGHT=0.50

# Replace these assumptions with the selected venue's actual costs.
PMS_FEE_RATE=0.0
# Baseline Kalshi taker coefficient; series/event overrides still need verification.
PMS_BINARY_FEE_COEFFICIENT=0.07
PMS_SLIPPAGE_BPS=25
PMS_RESOLUTION_HAIRCUT=0.01
PMS_MINIMUM_ASK_SIZE=10

PMS_FRACTIONAL_KELLY=0.25
PMS_MAX_BANKROLL_FRACTION=0.02
PMS_MINIMUM_SECONDS_TO_EXPIRY=300
